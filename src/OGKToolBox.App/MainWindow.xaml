te></ListBox.ItemTemplate></ListBox><Button Grid.Row="3" Command="{Binding ExportUnityAssetGraphCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch" ToolTip="导出对象 PathId、类型、名称及所有 PPtr 依赖，不修改源文件">导出资源引用图</Button></Grid></Border></Grid></Grid>

