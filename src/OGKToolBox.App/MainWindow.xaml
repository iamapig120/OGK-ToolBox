<Window x:Class="OGKToolBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OGKToolBox.App.Converters"
        xmlns:controls="clr-namespace:OGKToolBox.App.Controls"
        xmlns:views="clr-namespace:OGKToolBox.App.Views"
        Title="春菜的便当盒" Width="1480" Height="920" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseImageViewerCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenChartPlayerCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <conv:PageVisibilityConverter x:Key="PageVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:NullToBooleanConverter x:Key="NullToBool"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource SurfacePanel}"/>
        <Style x:Key="HighQualityPreviewImage" TargetType="Image"><Setter Property="RenderOptions.BitmapScalingMode" Value="Fant"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="StretchDirection" Value="DownOnly"/></Style>
        <Style x:Key="ImagePreviewButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/><Border x:Name="Hint" Background="#B3000000" CornerRadius="5" Padding="9,5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10" Opacity="0" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="{StaticResource FluentIcons}" Foreground="White" Margin="0,0,6,0"/><TextBlock Text="点击查看大图" Foreground="White" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hint" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#F1F2F4" Geometry="M0,0 H16 V16 H0 Z"/><GeometryDrawing Brush="#E4E6E9" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding SelectedUiScale}" ScaleY="{Binding SelectedUiScale}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="/Assets/haruna-lunchbox.jpg" Width="40" Height="40" Opacity="0" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"><Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="10" RadiusY="10"/></Image.Clip></Image>
                        <Border Background="#3F2E9A" CornerRadius="10"><TextBlock Text="OGK" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="春菜的便当盒" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="OGKToolBox · ONGEKI 工具" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/></StackPanel>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation}" Margin="10,4">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="11,8"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Style="{StaticResource FluentIcon}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Margin="14,12,14,18" Padding="12,10" Background="{DynamicResource InfoSoftBrush}" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE72E;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="资源只读" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="配置保存需确认 · Mod 单击切换" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,11" Background="{DynamicResource SurfaceBrush}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentPage}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding GameRootDisplay}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/></StackPanel>
                    <Button Grid.Column="1" Command="{Binding ChooseGameFolderCommand}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}" Margin="0,0,7,0"/><TextBlock Text="选择目录"/></StackPanel></Button>
                    <Button Grid.Column="2" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource FluentIcon}" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="重新扫描" Foreground="White"/></StackPanel></Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,22">
                <!-- 首页 -->
                <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=首页}" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Opacity>0</ScrollViewer.Opacity>
                    <Grid>
                    <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
                        <TextBlock Text="&#x8FD0;&#x884C;&#x6982;&#x89C8;" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="&#x786E;&#x8BA4;&#x5F53;&#x524D;&#x6E38;&#x620F;&#x73AF;&#x5883;&#x662F;&#x5426;&#x53EF;&#x4EE5;&#x76F4;&#x63A5;&#x542F;&#x52A8;&#x3002;&#x8D44;&#x6E90;&#x660E;&#x7EC6;&#x8BF7;&#x4ECE;&#x5DE6;&#x4FA7;&#x5BF9;&#x5E94;&#x9875;&#x9762;&#x67E5;&#x770B;&#x3002;" Style="{StaticResource MutedText}" Margin="0,5,0,20"/>
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="20,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE943;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource AccentBrush}" FontSize="18"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="&#x6E38;&#x620F;&#x7248;&#x672C;" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding GameVersionDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="&#x2713;" Foreground="{DynamicResource SuccessBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                            <Border Grid.Column="2" Padding="20,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Panel}"><Style.Triggers><DataTrigger Binding="{Binding IsSegaToolsInstalled}" Value="False"><Setter Property="Opacity" Value="0.52"/><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource InfoSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE950;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource InfoBrush}" FontSize="18"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Segatools" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding SegaToolsStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#x2713;"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSegaToolsInstalled}" Value="False"><Setter Property="Text" Value="&#xD7;"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
                            <Border Grid.Column="4" Padding="20,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Panel}"><Style.Triggers><DataTrigger Binding="{Binding IsControllerConnected}" Value="False"><Setter Property="Opacity" Value="0.46"/><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource AccentBrush}" FontSize="18"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="&#x63A7;&#x5236;&#x5668;" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ControllerStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="&#x2713;" Foreground="{DynamicResource SuccessBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource InfoSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource InfoBrush}"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="&#x5065;&#x5EB7;&#x5EA6;&#x4E0E;&#x9700;&#x8981;&#x6CE8;&#x610F;" Style="{StaticResource SectionTitle}"/><TextBlock Text="&#x626B;&#x63CF;&#x8BCA;&#x65AD;&#x4E0E;&#x542F;&#x52A8;&#x73AF;&#x5883;&#x96C6;&#x4E2D;&#x663E;&#x793A;&#x5728;&#x8FD9;&#x91CC;" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center"><TextBlock Text="{Binding HealthStatus}" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" FontSize="12"/></Border></Grid><Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ErrorCount, StringFormat={}{0} &#x9879;&#x626B;&#x63CF;&#x9519;&#x8BEF;}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="&#x5355;&#x4E2A;&#x6587;&#x4EF6;&#x5F02;&#x5E38;&#x4E0D;&#x4F1A;&#x4E2D;&#x65AD;&#x5176;&#x4ED6;&#x8D44;&#x6E90;&#xFF1B;&#x5728;&#x8BCA;&#x65AD;&#x9875;&#x53EF;&#x67E5;&#x770B;&#x5177;&#x4F53;&#x6765;&#x6E90;&#x548C;&#x8BF4;&#x660E;&#x3002;" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,5,18,0"/></StackPanel><Button Grid.Column="1" Content="&#x67E5;&#x770B;&#x8BCA;&#x65AD;" Command="{Binding NavigateCommand}" CommandParameter="&#x8BCA;&#x65AD;" VerticalAlignment="Center"/></Grid></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="22"><StackPanel><TextBlock Text="&#x5FEB;&#x6377;&#x64CD;&#x4F5C;" Style="{StaticResource SectionTitle}"/><TextBlock Text="&#x53EA;&#x4FDD;&#x7559;&#x6700;&#x5E38;&#x7528;&#x7684;&#x73AF;&#x5883;&#x64CD;&#x4F5C;" Style="{StaticResource CaptionText}" Margin="0,4,0,16"/><Button Content="&#x91CD;&#x65B0;&#x626B;&#x63CF;" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Segatools &#x914D;&#x7F6E;" Command="{Binding NavigateCommand}" CommandParameter="Segatools" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Mod &#x7BA1;&#x7406;" Command="{Binding NavigateCommand}" CommandParameter="Mod &#x7BA1;&#x7406;" HorizontalAlignment="Stretch"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock Text="????" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="????????????????????????????????" Style="{StaticResource MutedText}" Margin="0,5,0,20"/>
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="20,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE943;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource AccentBrush}" FontSize="18"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="????" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding GameVersionDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="?" Foreground="{DynamicResource SuccessBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                            <Border Grid.Column="2" Padding="20,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Panel}"><Style.Triggers><DataTrigger Binding="{Binding IsSegaToolsInstalled}" Value="False"><Setter Property="Opacity" Value="0.52"/><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource InfoSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE950;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource InfoBrush}" FontSize="18"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Segatools" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding SegaToolsStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="?"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSegaToolsInstalled}" Value="False"><Setter Property="Text" Value="?"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
                            <Border Grid.Column="4" Padding="20,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Panel}"><Style.Triggers><DataTrigger Binding="{Binding IsControllerConnected}" Value="False"><Setter Property="Opacity" Value="0.46"/><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource AccentBrush}" FontSize="18"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="???" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ControllerStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="?" Foreground="{DynamicResource SuccessBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource InfoSoftBrush}" CornerRadius="9"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource InfoBrush}"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="????????" Style="{StaticResource SectionTitle}"/><TextBlock Text="????????????????" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center"><TextBlock Text="{Binding HealthStatus}" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" FontSize="12"/></Border></Grid><Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ErrorCount, StringFormat={}{0} ?????}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="??????????????????????????????" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,5,18,0"/></StackPanel><Button Grid.Column="1" Content="????" Command="{Binding NavigateCommand}" CommandParameter="??" VerticalAlignment="Center"/></Grid></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="22"><StackPanel><TextBlock Text="????" Style="{StaticResource SectionTitle}"/><TextBlock Text="???????????" Style="{StaticResource CaptionText}" Margin="0,4,0,16"/><Button Content="????" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Segatools ??" Command="{Binding NavigateCommand}" CommandParameter="Segatools" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Mod ??" Command="{Binding NavigateCommand}" CommandParameter="Mod ??" HorizontalAlignment="Stretch"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock Text="资源工作台" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="集中浏览 SDDT 曲库、谱面、卡片、角色与原始资源。A000、Option 与资源文件始终只读。" Style="{StaticResource MutedText}" Margin="0,5,0,20"/>
                        <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="有效乐曲" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding MusicCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="0,2"/>
                            <StackPanel Grid.Column="2" Margin="20,0"><TextBlock Text="关联谱面" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ChartCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Margin="0,2"/>
                            <StackPanel Grid.Column="4" Margin="20,0"><TextBlock Text="资源条目" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ResourceCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="5" Background="{DynamicResource DividerBrush}" Margin="0,2"/>
                            <StackPanel Grid.Column="6" Margin="20,0,0,0"><TextBlock Text="数据包" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding PackageCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}" Margin="0,5,0,0"/></StackPanel>
                        </Grid></Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource AccentBrush}"/></Border><TextBlock Grid.Column="1" Text="建立资源索引" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid><TextBlock Text="选择 ONGEKI 的 package 目录。春菜的便当盒会读取 A000 与所有兼容 Option，保留来源和覆盖关系；首次扫描后直接从本地缓存恢复。" TextWrapping="Wrap" TextTrimming="None" Style="{StaticResource MutedText}" Margin="0,14,0,18" MaxWidth="650" HorizontalAlignment="Left"/><WrapPanel><Button Content="选择游戏目录" Command="{Binding ChooseGameFolderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="导出 JSON / CSV 索引" Command="{Binding ExportIndexCommand}" Margin="0,0,8,0"/><Button Content="导出谱面渲染清单" Command="{Binding ExportChartRenderAssetManifestCommand}"/></WrapPanel></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{DynamicResource InfoSoftBrush}" CornerRadius="7"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource InfoBrush}"/></Border><TextBlock Grid.Column="1" Text="扫描诊断" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid><TextBlock Text="{Binding ErrorCount, StringFormat={}{0} 个错误}" Foreground="{DynamicResource DangerBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="单文件失败不会中断其余资源。可在诊断页查看缺失引用、损坏资源和覆盖信息。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextTrimming="None"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
                <views:HomeView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=&#x9996;&#x9875;}"/>

                <!-- 乐曲 -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=乐曲}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="380" HorizontalAlignment="Left"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" ToolTip="按标题、艺术家或 ID 筛选"/><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid><Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center"><TextBlock Text="{Binding Music.Count, StringFormat={}{0:N0} 首乐曲}" Style="{StaticResource CaptionText}"/></Border></Grid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
