<Window x:Class="OGKToolBox.App.ChartPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OGKToolBox.App.Controls"
        Title="{Binding SelectedMusic.Title, StringFormat=谱面预览 · {0}}"
        Width="540" Height="920" MinWidth="360" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        UseLayoutRounding="True" Background="#04060B">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseChartPlayerCommand}"/>
        <KeyBinding Key="Space" Command="{Binding ToggleChartPlaybackCommand}"/>
        <KeyBinding Key="Left" Command="{Binding SeekChartBackwardCommand}"/>
        <KeyBinding Key="Right" Command="{Binding SeekChartForwardCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="Background" Value="#E8141D2A"/>
            <Setter Property="BorderBrush" Value="#4B617F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F01B2738"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#607695"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF223147"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF0FA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#26364C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30425C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="Background" Value="#FF111925"/>
            <Setter Property="BorderBrush" Value="#4B617F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource OverlayComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root" Background="#FF111925" BorderBrush="#4B617F"
                                                BorderThickness="1" CornerRadius="7" Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                  TextElement.Foreground="#F1F5FC"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource FluentIcons}"
                                                           Foreground="#BFCBE0" FontSize="9"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#FF182333"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#607695"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#FF1D2A3C"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#7187A5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="#F1F5FC"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=Toggle}" Margin="0,4,0,0"
                                        Background="#FF0E1622" BorderBrush="#526783"
                                        BorderThickness="1" CornerRadius="7" Padding="4">
                                    <ScrollViewer MaxHeight="260" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimelineSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#E968A2F8" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Root" Fill="#F4F7FC" Stroke="#6EA8FF" StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Fill" Value="#FFFFFF"/>
                                                        <Setter TargetName="Root" Property="Stroke" Value="#8BBCFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Root" Property="Fill" Value="#DDEBFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#566579" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#04060B">
        <controls:ChartPreviewControl Preview="{Binding ChartPreview}"
                                      CurrentSeconds="{Binding ChartPositionSeconds}"
                                      ScrollSpeed="{Binding ChartScrollSpeed}"/>

        <Grid Panel.ZIndex="2" Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel MaxWidth="330" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SelectedMusic.Title}" Foreground="#F6F8FC" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="#D5E0F4" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SelectedChart.DifficultyName}"/><Run Text=" · "/><Run Text="{Binding SelectedChart.Creator}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ChartPreviewSummary}" Foreground="#B8C7E2" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ChartPositionText}" Foreground="#F6F8FC" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Foreground="#C4D1E8" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Right">
                        <Run Text="SPEED "/><Run Text="{Binding ChartScrollSpeed, StringFormat={}{0:0.00}}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="ControlsPanel" Margin="0,0,46,0" Background="#F20B111C"
                        BorderBrush="#35465E" BorderThickness="1" CornerRadius="10" Padding="8,10">
                    <StackPanel>
                        <Button Command="{Binding ToggleChartPlaybackCommand}" Style="{StaticResource OverlayButton}"
                                Width="48" Height="48" ToolTip="播放 / 暂停（空格）">
                            <TextBlock Text="{Binding ChartPlaybackGlyph}" Style="{StaticResource FluentIcon}" Foreground="#F6F8FC" FontSize="18"/>
                        </Button>
                        <Button Command="{Binding RestartChartCommand}" Style="{StaticResource OverlayButton}" Margin="0,7,0,0" ToolTip="回到开头">
                            <TextBlock Text="&#xE777;" Style="{StaticResource FluentIcon}" Foreground="#F6F8FC"/>
                        </Button>
                        <TextBlock Text="流速" Foreground="#D5E0F4" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                        <Border Background="#FF111925" BorderBrush="#4B617F" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="27"/>
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding DecreaseChartScrollSpeedCommand}" IsEnabled="{Binding CanDecreaseChartScrollSpeed}"
                                        Style="{StaticResource OverlayButton}" MinWidth="0" MinHeight="34" Padding="0"
                                        Background="Transparent" BorderBrush="Transparent" ToolTip="流速降低一档">
                                    <TextBlock Text="&lt;" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding ChartScrollSpeedText}" Foreground="#F1F5FC"
                                           FontSize="13" FontWeight="SemiBold" FontFamily="Consolas"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding IncreaseChartScrollSpeedCommand}" IsEnabled="{Binding CanIncreaseChartScrollSpeed}"
                                        Style="{StaticResource OverlayButton}" MinWidth="0" MinHeight="34" Padding="0"
                                        Background="Transparent" BorderBrush="Transparent" ToolTip="流速提高一档">
                                    <TextBlock Text="&gt;" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Text="倍速" Foreground="#D5E0F4" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,4" HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ChartPlaybackSpeeds}" SelectedItem="{Binding ChartPlaybackSpeed}"
                                  Width="76" Style="{StaticResource OverlayCombo}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Foreground="#F1F5FC" Text="{Binding StringFormat={}{0:0.##}×}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Button x:Name="ControlsToggle" Width="38" Height="54" HorizontalAlignment="Right"
                        Style="{StaticResource OverlayButton}" Click="ToggleControlsClick"
                        ToolTip="展开控制栏">
                    <TextBlock x:Name="ControlsToggleGlyph" Text="‹" Foreground="#F1F5FC" FontSize="23" FontWeight="Normal"/>
                </Button>
            </Grid>

            <Border Grid.Row="2" Margin="12,0" Padding="14,9" Background="#D90B111C"
                    BorderBrush="#35465E" BorderThickness="1" CornerRadius="9"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="2,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="拖动定位" Foreground="#D5E0F4" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="原版游戏音效" Foreground="#D5E0F4" FontSize="12" FontWeight="SemiBold"
                                   Visibility="{Binding ChartUsesGameSounds, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                    <Slider Grid.Row="1" Minimum="0" Maximum="{Binding ChartDurationSeconds}"
                            Value="{Binding ChartPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,4,0,0" IsMoveToPointEnabled="True" Style="{StaticResource TimelineSlider}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="3" Visibility="{Binding IsLoadingChartPreview, Converter={StaticResource BoolToVisibility}}" Background="#D904060B">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="180" IsIndeterminate="True"/>
                <TextBlock Text="正在解析谱面…" Foreground="#F6F8FC" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
