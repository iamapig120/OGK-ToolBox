<UserControl x:Class="OGKToolBox.App.Views.ResourcesPencilView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{DynamicResource WorkspaceBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="&#x8D44;&#x6E90;&#x6D4F;&#x89C8;&#x5668;" Style="{StaticResource PageTitle}"/><TextBlock Text="&#x6D4F;&#x89C8; UnityFS Bundle &#x4E0E;&#x5176;&#x4E2D;&#x7684;&#x56FE;&#x50CF;&#x8D44;&#x6E90;&#x3002;" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions><Border Style="{StaticResource SurfacePanel}" Padding="0"><DataGrid ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="&#x8D44;&#x6E90;&#x540D;" Binding="{Binding Key}" Width="2*"/><DataGridTextColumn Header="&#x7C7B;&#x578B;" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="&#x6570;&#x636E;&#x5305;" Binding="{Binding Origin.PackageId}" Width="100"/><DataGridTextColumn Header="&#x5927;&#x5C0F;" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="100"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource CheckerBrush}" CornerRadius="8"><Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"/></Border><TextBlock Grid.Row="1" Text="Texture2D" Style="{StaticResource SectionTitle}" Margin="0,15,0,8"/><ListBox Grid.Row="2" ItemsSource="{Binding BundleImages}" SelectedItem="{Binding SelectedBundleImage}" DisplayMemberPath="Name"/><Button Grid.Row="3" Content="&#x5BFC;&#x51FA;&#x8D44;&#x6E90;&#x5F15;&#x7528;&#x56FE;" Command="{Binding ExportUnityAssetGraphCommand}" Margin="0,14,0,0"/></Grid></Border></Grid></Grid></UserControl>
