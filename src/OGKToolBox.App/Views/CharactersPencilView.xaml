<UserControl x:Class="OGKToolBox.App.Views.CharactersPencilView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{DynamicResource WorkspaceBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="&#x89D2;&#x8272;&#x5E93;" Style="{StaticResource PageTitle}"/><TextBlock Text="&#x6D4F;&#x89C8;&#x89D2;&#x8272;&#x6A21;&#x578B;&#x4E0E;&#x8868;&#x60C5;&#x8D44;&#x6E90;&#x3002;" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource SurfacePanel}" Padding="8"><ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModelId}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
<Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource CheckerBrush}" CornerRadius="8"><Button Style="{StaticResource ImagePreviewButton}" Command="{Binding OpenImageViewerCommand}"><Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="12"/></Button></Border><StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock Text="{Binding SelectedCharacter.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCharacter.FlavorText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid></Border>
<Border Grid.Column="4" Style="{StaticResource SurfacePanel}" Padding="14"><StackPanel><TextBlock Text="&#x8868;&#x60C5;" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><ListBox ItemsSource="{Binding CharacterExpressions}" SelectedItem="{Binding SelectedCharacterExpression}" DisplayMemberPath="Label"/><Button Content="&#x5BFC;&#x51FA;&#x5F53;&#x524D;&#x56FE;&#x7247;" Command="{Binding ExportCharacterExpressionCommand}" Margin="0,14,0,0"/></StackPanel></Border>
</Grid></Grid></UserControl>
