<UserControl x:Class="OGKToolBox.App.Views.SegaToolsPencilView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid MaxWidth="858" HorizontalAlignment="Stretch">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Segatools &#x914D;&#x7F6E;" Style="{StaticResource PageTitle}"/><TextBlock Text="&#x96C6;&#x4E2D;&#x7BA1;&#x7406; mu3.ini &#x4E0E;&#x8857;&#x673A;&#x73AF;&#x5883;&#x53C2;&#x6570;&#x3002;" Foreground="#657386" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"/></StackPanel><Button Grid.Column="1" Content="&#x91CD;&#x65B0;&#x8BFB;&#x53D6;" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource SurfacePanel}" Padding="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#FFF8F4" BorderBrush="#E6EBF1" BorderThickness="0,0,0,1" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="&#x914D;&#x7F6E;&#x9879;" Foreground="#344154" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="&#x5F53;&#x524D;&#x503C;" Foreground="#657386" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding SelectedFile.DisplayName, FallbackValue=mu3.ini}" Foreground="#657386" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedFile.Entries}" Margin="0,0,0,58"><ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="58" BorderBrush="#E6EBF1" BorderThickness="0,0,0,1" Padding="16,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Section}" Foreground="#344154" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Key}" Foreground="#657386" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Foreground="#334154" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBox Grid.Column="2" Text="{Binding DisplayValue}" IsReadOnly="True" MinHeight="34" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Border Grid.Row="1" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" Padding="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ToolTip="{Binding LastBackupPath, StringFormat=&#x6700;&#x8FD1;&#x5907;&#x4EFD;&#xFF1A;{0}}">
     <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#263244"/></Border.Effect>
     <Button Content="&#x4FDD;&#x5B58;&#x914D;&#x7F6E;" Command="{Binding SavePreviewCommand}" IsEnabled="{Binding CanSavePreview}" Style="{StaticResource PrimaryButton}"/>
    </Border>
   </Grid>
  </Border>
 </Grid>
</UserControl>
