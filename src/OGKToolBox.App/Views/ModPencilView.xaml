<UserControl x:Class="OGKToolBox.App.Views.ModPencilView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mod &#x7BA1;&#x7406;" Style="{StaticResource PageTitle}"/><TextBlock Text="&#x67E5;&#x770B;&#x5DF2;&#x5B89;&#x88C5; Mod&#x3001;&#x72B6;&#x6001;&#x4E0E;&#x53EF;&#x7528;&#x914D;&#x7F6E;&#x3002;" Foreground="#657386" FontSize="13" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="&#x91CD;&#x65B0;&#x8BFB;&#x53D6;" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"/></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="344"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource SurfacePanel}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="10,8,10,10"><TextBlock Text="&#x5DF2;&#x5B89;&#x88C5; Mod" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ModConfigurationGroups.Count, StringFormat={}{0} &#x9879;}" Foreground="#6A7788" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding ModConfigurationGroups}" SelectedItem="{Binding SelectedModConfigurationGroup}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="#EEF2F6" CornerRadius="7"><TextBlock Text="&#xE74C;" Style="{StaticResource FluentIcon}" Foreground="#536174" FontSize="14"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding DisplayName}" Foreground="#344154" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Version}" Foreground="#748193" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Entries.Count, StringFormat={}{0}}" Foreground="#6A7788" FontSize="11" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Mod &#x5185;&#x5BB9;" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="&#x9009;&#x62E9;&#x5DE6;&#x4FA7; Mod &#x67E5;&#x770B;&#x5E76;&#x4FEE;&#x6539;&#x5176;&#x914D;&#x7F6E;&#x9879;&#x3002;" Foreground="#6A7788" FontSize="11" Margin="0,4,0,0"/></StackPanel><Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#E6EBF1" BorderThickness="1" CornerRadius="8" Margin="0,18,0,0" Padding="16"><StackPanel><TextBlock Text="{Binding SelectedEntry.Key, FallbackValue=&#x5C1A;&#x672A;&#x9009;&#x62E9;&#x914D;&#x7F6E;&#x9879;}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedEntry.Description}" Foreground="#6A7788" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,16"/><TextBlock Text="&#x914D;&#x7F6E;&#x503C;" Foreground="#6A7788" FontSize="11"/><TextBox Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSelectedEntry}" Margin="0,6,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="&#x751F;&#x6210;&#x5DEE;&#x5F02;" Command="{Binding PreviewChangeCommand}" IsEnabled="{Binding HasDraftChange}" Margin="0,0,8,0"/><Button Content="&#x653E;&#x5F03;&#x8349;&#x7A3F;" Command="{Binding RevertDraftCommand}" IsEnabled="{Binding HasDraftChange}"/></WrapPanel></StackPanel></Border><Button Grid.Row="2" Content="&#x4FDD;&#x5B58;&#x53D8;&#x66F4;" Command="{Binding SavePreviewCommand}" IsEnabled="{Binding CanSavePreview}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0"/></Grid></Border>
</Grid></Grid></UserControl>
