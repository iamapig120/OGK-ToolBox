<UserControl x:Class="OGKToolBox.App.Views.MusicPencilView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{DynamicResource WorkspaceBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="&#x4E50;&#x66F2;&#x5E93;" Style="{StaticResource PageTitle}"/><TextBlock Text="&#x6D4F;&#x89C8;&#x5DF2;&#x626B;&#x63CF;&#x7684;&#x4E50;&#x66F2;&#x4E0E;&#x8C31;&#x9762;&#x6570;&#x636E;&#x3002;" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="&#x91CD;&#x65B0;&#x626B;&#x63CF;" Command="{Binding ScanCommand}" VerticalAlignment="Bottom"/></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource SurfacePanel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16,0"><TextBlock Text="&#x4E50;&#x66F2;&#x5217;&#x8868;" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock Text="{Binding Music.Count, StringFormat=&#x5171; {0} &#x9996;}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Music}" SelectedItem="{Binding SelectedMusic}" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="&#x6807;&#x9898;" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="&#x827A;&#x672F;&#x5BB6;" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="&#x5206;&#x7C7B;" Binding="{Binding Category}" Width="110"/></DataGrid.Columns></DataGrid></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="18"><StackPanel><Border Height="210" Background="{StaticResource CheckerBrush}" CornerRadius="8"><Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="7"/></Border><TextBlock Text="{Binding SelectedMusic.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedMusic.Artist}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><Separator Margin="0,16,0,12"/><TextBlock Text="&#x4E50;&#x66F2;&#x8BE6;&#x60C5;" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SelectedMusic.Origin.PackageId}" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel></Border>
</Grid></Grid></UserControl>
