<UserControl x:Class="OGKToolBox.App.Views.ModManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mod 管理" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="展开 Mod 可修改其 mu3.ini 子项；原版配置归入独立分组。保存前仍会显示差异并创建备份。"
                           Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="重新读取" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ModConfigurationGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="True" Margin="0,0,0,8">
                                <Expander.Header>
                                    <Grid MinWidth="360" Margin="4,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" ToolTip="{Binding Description}"/>
                                            <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Visibility="{Binding IsInstalledMod, Converter={StaticResource BoolToVisibility}}"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding Mod}"
                                                  IsEnabled="{Binding DataContext.CanToggleMods, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  ToolTip="单击启用或停用此 Mod；停用后其可新增配置项将不再显示。"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                <ListBox ItemsSource="{Binding Entries}"
                                         SelectedItem="{Binding DataContext.SelectedEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         BorderThickness="0" Margin="14,3,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Section}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="此 Mod 没有可配置的 mu3.ini 参数。"
                                           Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibility}}"
                                           Style="{StaticResource CaptionText}" Margin="18,3,0,10"/>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedEntry.Key, FallbackValue=选择一个配置项}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SelectedEntry.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="配置值" Style="{StaticResource CaptionText}" Margin="1,0,0,4"/>
                        <TextBox Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSelectedEntry}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="设为 0（关闭）" Command="{Binding SetDraftValueCommand}" CommandParameter="0" IsEnabled="{Binding CanEditSelectedEntry}" Margin="0,0,7,0"/>
                            <Button Content="设为 1（开启）" Command="{Binding SetDraftValueCommand}" CommandParameter="1" IsEnabled="{Binding CanEditSelectedEntry}"/>
                        </WrapPanel>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="生成差异" Command="{Binding PreviewChangeCommand}" IsEnabled="{Binding HasDraftChange}" Margin="0,0,7,0"/>
                        <Button Content="放弃草稿" Command="{Binding RevertDraftCommand}" IsEnabled="{Binding HasDraftChange}" Style="{StaticResource SubtleButton}"/>
                    </WrapPanel>
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="11" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="差异预览" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PreviewSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <ItemsControl ItemsSource="{Binding ChangePreview.Changes}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding OriginalValue, StringFormat=原值：{0}}" FontFamily="Consolas"/><TextBlock Text="{Binding NewValue, StringFormat=新值：{0}}" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="4" Content="确认并保存" Command="{Binding SavePreviewCommand}" IsEnabled="{Binding CanSavePreview}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
