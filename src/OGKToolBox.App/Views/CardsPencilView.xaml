<UserControl x:Class="OGKToolBox.App.Views.CardsPencilView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{DynamicResource WorkspaceBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="&#x5361;&#x7247;&#x5E93;" Style="{StaticResource PageTitle}"/><TextBlock Text="&#x5DF2;&#x626B;&#x63CF;&#x5230;&#x7684;&#x5361;&#x7247;&#x8D44;&#x6E90;&#x4E0E;&#x63D2;&#x753B;&#x3002;" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="&#x6E05;&#x9664;&#x7B5B;&#x9009;" Command="{Binding ClearCardFiltersCommand}" Margin="0,0,8,0"/><TextBlock Text="{Binding FilteredCardCount, StringFormat={}{0} &#x5F20;}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/></StackPanel></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource SurfacePanel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16,0"><TextBlock Text="&#x5361;&#x7247;" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock Text="&#x70B9;&#x51FB;&#x67E5;&#x770B;&#x8BE6;&#x60C5;" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCards}" SelectedItem="{Binding SelectedCard}" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="&#x540D;&#x79F0;" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="&#x89D2;&#x8272;" Binding="{Binding CharacterName}" Width="*"/><DataGridTextColumn Header="&#x7A00;&#x6709;&#x5EA6;" Binding="{Binding Rarity}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="18"><StackPanel><Border Height="360" Background="{StaticResource CheckerBrush}" CornerRadius="8"><Button Style="{StaticResource ImagePreviewButton}" Command="{Binding OpenImageViewerCommand}"><Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="7"/></Button></Border><TextBlock Text="{Binding SelectedCard.Name}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedCard.NickName}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><WrapPanel Margin="0,14,0,0"><Button Content="&#x5BFC;&#x51FA;&#x5F53;&#x524D;&#x56FE;&#x7247;" Command="{Binding ExportCardImageCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="&#x5168;&#x90E8;&#x5BFC;&#x51FA;" Command="{Binding ExportCardAssetsCommand}" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
</Grid></Grid></UserControl>
