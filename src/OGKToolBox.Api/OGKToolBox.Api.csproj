<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OGKToolBox.Api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OGKToolBox.Application/OGKToolBox.Application.csproj" />
    <ProjectReference Include="../OGKToolBox.Core/OGKToolBox.Core.csproj" />
    <ProjectReference Include="../OGKToolBox.Infrastructure/OGKToolBox.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../tools/vgmstream/**" Link="tools/vgmstream/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../tools/unity/classdata.tpk" Link="tools/unity/classdata.tpk" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
